(declare-const used Int)
(declare-const saved Int)
(declare-const remaining Int)
(declare-const normalized Int)
(declare-const copied Int)
(declare-const action Int)
(declare-const next_used Int)
(declare-const n Int)
(declare-const i Int)
(declare-const next_i Int)
(declare-const violation Bool)
(assert (! (and (<= 0 used) (<= used 65536) (<= 0 saved) (<= saved 65536)
               (<= 0 remaining) (<= remaining 536870911)
               (<= 0 n) (<= n 536870911) (<= 0 i) (<= i n)) :named prior_private_invariants))
(assert (! (and (<= 0 action) (<= action 4)) :named byte_copy_reset_restore_string_actions))
(assert (! (= normalized (ite (= used 65536) 0 used)) :named full_buffer_flush))
(assert (! (= copied (ite (< remaining (- 65536 normalized)) remaining (- 65536 normalized))) :named checked_bulk_copy_count))
(assert (! (=> (= action 4) (not (= i n))) :named string_step_guard))
(assert (! (= next_used (ite (= action 0) (+ normalized 1)
                  (ite (= action 1) (+ normalized copied)
                  (ite (= action 2) 0 (ite (= action 3) saved used))))) :named next_scratch_cursor))
(assert (! (= next_i (ite (= action 4) (+ i 1) i)) :named next_string_cursor))
(assert (! (= violation (or (< next_used 0) (> next_used 65536) (< next_i 0) (> next_i n))) :named derived_violation))
(assert (! violation :named counterexample))
