;; Guarded whole-String parser. Scalar conversion remains stock data.json.
;; Unsupported/deep/malformed inputs decline without mutating caller state.
(lambda (s decode-string decode-number)
  (call/cc
   (lambda (decline)
     (let ((n (string-length s)) (i 0))
       (define (bad) (decline #f))
       (define (peek) (if (fx< i n) (string-ref s i) (bad)))
       (define (advance) (set! i (fx+ i 1)))
       (define (space)
         (let loop ()
           (when (and (fx< i n) (memv (string-ref s i) '(#\space #\tab #\newline #\return)))
             (advance) (loop))))
       (define (take c)
         (unless (char=? (peek) c) (bad)) (advance))
       (define (text)
         (take #\")
         (let ((start i))
           (let loop ()
             (let ((c (peek)))
               (cond ((char=? c #\")
                      (let ((out (substring s start i))) (advance) out))
                     ((char=? c #\\)
                      ;; Reuse the existing bounded native token decoder for
                      ;; escaped keys (the maintained writer escapes slashes).
                      (let ((result (decode-string s start)))
                        (unless (pvec? result) (bad))
                        (set! i (pvec-nth! result 1))
                        (pvec-nth! result 0)))
                     ((fx< (char->integer c) 32) (bad))
                     (else (advance) (loop)))))))
       (define (literal spelling value)
         (let ((len (string-length spelling)))
           (unless (and (fx<= (fx+ i len) n)
                        (string=? spelling (substring s i (fx+ i len)))) (bad))
           (set! i (fx+ i len)) value))
       (define (number)
         (let ((start i))
           (let loop ()
             (if (or (fx= i n) (memv (string-ref s i)
                                 '(#\space #\tab #\newline #\return #\, #\] #\})))
                 (begin
                   (when (fx= i start) (bad))
                   (let ((decoded (decode-number (substring s start i))))
                     (if (eq? decoded #f) (bad) decoded)))
                 (begin (advance) (loop))))))
       (define (object depth)
         (take #\{) (space)
         (if (char=? (peek) #\}) (begin (advance) empty-pmap)
             (let loop ((out empty-pmap))
               (let ((key (text)))
                 (when (pmap-contains? out key) (bad))
                 (space) (take #\:) (space)
                 (let ((next (pmap-assoc out key (value depth))))
                   (space)
                   (case (peek)
                     ((#\}) (advance) next)
                     ((#\,) (advance) (space) (loop next))
                     (else (bad))))))))
       (define (array depth)
         (take #\[) (space)
         (if (char=? (peek) #\]) (begin (advance) (jolt-vector))
             (let loop ((out (jolt-vector)))
               (let ((next (pvec-conj out (value depth))))
                 (space)
                 (case (peek)
                   ((#\]) (advance) next)
                   ((#\,) (advance) (space) (loop next))
                   (else (bad)))))))
       (define (value depth)
         (space)
         (case (peek)
           ((#\{) (when (fx>= depth 64) (bad)) (object (fx+ depth 1)))
           ((#\[) (when (fx>= depth 64) (bad)) (array (fx+ depth 1)))
           ((#\") (text))
           ((#\n) (literal "null" jolt-nil))
           ((#\t) (literal "true" #t))
           ((#\f) (literal "false" #f))
           (else (number))))
       (let ((out (value 0)))
         (let ((end i))
           (space) (unless (fx= i n) (bad))
           ;; Successful cursor is before trailing whitespace, as in stock read.
           (jolt-vector out end)))))))
